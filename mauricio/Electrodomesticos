package Electrodomestico;

import java.security.PublicKey;

public class CLavadora extends CElectrodomestico{
    private static final double CARGA_DEFAULT = 5;

    double carga;

    public CLavadora () {
        super();
        this.carga = CARGA_DEFAULT;
    }
    public CLavadora (double _precio, double _peso) {
        super(_precio, _peso);
        this.carga = CARGA_DEFAULT;
    }
    public CLavadora (double _precio, double _peso, String _color, char _consumoEnergetico, double _carga, int _EfTermica) {
        super(_precio, _peso, _color, _consumoEnergetico, _EfTermica);
        this.carga = _carga;
    }
    public double getCarga() {
        return carga;
    }
    @Override
    public double precioFinal() {
        double pF = super.precioFinal();
        if(carga > 30){
            pF += 50;
        } return pF;
    }
    public void mostrarInfo() {
        super.mostrarInfo();
        System.out.println("carga: "+getCarga());
    }

}

// CTelevisor

package Electrodomestico;

import java.security.PublicKey;

public class CTelevisor extends CElectrodomestico{
    public static final int PULGADAS_DEFAULT = 20;
    public static final boolean TDT_DEFAULT = false;

    int pulgadas;
    boolean TDT;
    public CTelevisor () {
        super ();
        this.pulgadas = PULGADAS_DEFAULT;
        this.TDT = TDT_DEFAULT;
    }
    public CTelevisor(double _precio, double _peso) {
        super(_precio, _peso);
        this.pulgadas = PULGADAS_DEFAULT;
        this.TDT = TDT_DEFAULT;
    }
    public CTelevisor(double _precio, double _peso, String _color, char _consumoEnergetico, int _pulgadas, int _EfTermica, boolean _TDT) {
        super(_precio, _peso, _color, _consumoEnergetico, _EfTermica);
        this.pulgadas = _pulgadas;
        this.TDT = _TDT;
    }
    public int getPulgadas () {
        return pulgadas;
    }
    public boolean getTDT () {
        return TDT;
    }
    @Override
    public double precioFinal() {
        double pF = super.precioFinal();
        if(pulgadas >= 40){
            pF += pF * 0.30;
        }
        if (TDT) {
            pF += 50;
        }
        return pF;
    }
    public void mostrarInfo() {
        super.mostrarInfo();
        System.out.println("pulgadas: "+getPulgadas());
        System.out.println("TDT: "+getTDT());
    }
}


