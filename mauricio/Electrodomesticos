// CElectrodomestico:

package Electrodomestico;

public class CElectrodomestico {
    private static final double PRECIO_DEFAULT = 100;
    private static final String COLOR_DEFAULT = "Blanco";
    private static final char CONSUMO_DEFAULT = 'C';
    private static final double PESO_DEFAULT = 5;
    private static final int EfTERMICA_DEFAULT = 5;

    double precio;
    String color;
    char consumoEnergetico;
    double peso;
    int EfTermica;

    public CElectrodomestico() {
        this.precio = PRECIO_DEFAULT;
        this.color = COLOR_DEFAULT;
        this.consumoEnergetico = CONSUMO_DEFAULT;
        this.peso = PESO_DEFAULT;
        this.EfTermica = EfTERMICA_DEFAULT;

        comprobarConsumoEnergetico(this.consumoEnergetico);

        comprobarColor(this.color);
        comprobarEfTermica((int) this.EfTermica);
    }
    public CElectrodomestico(double _precio, double _peso) {
        this.precio = _precio;
        this.peso = _peso;
        this.color = COLOR_DEFAULT;
        this.consumoEnergetico = CONSUMO_DEFAULT;
        this.EfTermica = EfTERMICA_DEFAULT;

        comprobarConsumoEnergetico(this.consumoEnergetico);

        comprobarColor(this.color);
        comprobarEfTermica((int) this.EfTermica);
    }
    public CElectrodomestico(double _precio, double _peso, String _color, char _consumoEnergetico, int _EfTermica) {
        this.precio = _precio;
        this.peso = _peso;
        this.color = _color;
        this.consumoEnergetico = _consumoEnergetico;
        this.EfTermica = _EfTermica;
        comprobarConsumoEnergetico(this.consumoEnergetico);

        comprobarColor(this.color);
        comprobarEfTermica((int) this.EfTermica);
    }
    public double getPrecio() {
        return precio;
    }
    public String getColor() {
        return color;
    }
    public char getConsumoEnergetico() {
        return consumoEnergetico;
    }
    public double getPeso() {
        return peso;
    }
    public int getEfTermica() {
        return EfTermica;
    }
    public void comprobarEfTermica (int e) {
        if(e > 10 || e < 1) {
            EfTermica = EfTERMICA_DEFAULT;
        }

        if(e >= 1 && e <= 3) {
            precio += 40;
        } else if (e >= 4 && e <= 6){
            precio+=20;
        } else if (e >= 7 && e <= 9){
            precio+=10;
        } else if(e == 10){
            precio+=5;
        }
    }
    public void comprobarConsumoEnergetico(char a) {
        if (a != 'A' && a != 'B' && a != 'C' && a != 'D' && a != 'E' && a != 'F') {
            consumoEnergetico = CONSUMO_DEFAULT;
        }
    }
    public void comprobarColor(String C) {
        if (!C.matches("(?i)(Blanco|Rojo|Azul|Gris|Negro|Amarillo|Rosado|morado|vino)")) {
            color = COLOR_DEFAULT;
        }
    }
    public double precioFinal() {
        double pF = precio;
        switch (consumoEnergetico) {
            case 'A': pF += 100; break;
            case 'B': pF += 80; break;
            case 'C': pF += 60; break;
            case 'D': pF += 50; break;
            case 'E': pF += 30; break;
            case 'F': pF += 10; break;
        }
        if (peso >= 0 && peso <= 19) {
            pF += 10;
        } else if (peso >= 20 && peso <= 49) {
            pF += 50;
        } else if (peso >= 50 && peso <= 79) {
            pF += 50;
        } else if (peso > 80) {
            pF += 100;
        }
        return pF;
    }

    @Override
    public String toString() {
        return "CElectrodomestico{" +
                "precio=" + precio +
                ", color='" + color + '\'' +
                ", consumoEnergetico=" + consumoEnergetico +
                ", peso=" + peso + "EfTermica=" + EfTermica +
                '}';
    }
    public void mostrarInfo() {
        System.out.println("Precio: "+getPrecio());
        System.out.println("Color: "+getColor());
        System.out.println("Consumo energetico: "+getConsumoEnergetico());
        System.out.println("peso: "+getPeso());
        System.out.println("Eficiencia Termica: " + getEfTermica());
    }

}


